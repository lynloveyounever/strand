# Copy to .env locally. Never commit real values or put them in VITE_* variables.
# Required: two DIFFERENT operator-chosen secrets, at least 32 non-whitespace ASCII chars.
# Leave the agent token blank until you explicitly want external MCP access.
STRAND_OWNER_TOKEN=
STRAND_AGENT_TOKEN=
STRAND_DATABASE_PATH=/data/strand.sqlite3
# Exact front-end origins only; no wildcard. Add the existing private Site origin
# only when you explicitly connect that Site to this server.
STRAND_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STRAND_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional. All three fields are required together. Never entered in the browser.
STRAND_PROVIDER_BASE_URL=
STRAND_PROVIDER_MODEL=
STRAND_PROVIDER_API_KEY=
